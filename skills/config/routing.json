{
  "schemaVersion": "1.0",
  "meta": {
    "description": "Single source of truth for reverse-skill task routing. master-route.ps1, master-route.sh, verify-routing-coherence.ps1, test-routing.ps1, and extract-summaries.ps1 all read from this file. Change routing rules only in this file. Do not edit route tables scattered in markdown or ps1 files (docs are maintained by generator scripts, or kept consistent with this file).",
    "fallbackId": "R0",
    "scoring": "Each matched keyword rule adds one point to its route. The highest-scoring route becomes PRIMARY in priority-array order. On a tie, the route earlier in the priority array wins. When no rule matches, the router falls back to fallbackId.",
    "maintainers": [
      "The priority table in skills/MASTER-ROUTING.md maps one-to-one to the priority field in this file",
      "skills/scripts/verify-routing-coherence.ps1 verifies that the two stay consistent"
    ]
  },
